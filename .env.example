# PostgreSQL connection string used by the application.
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# If not set, the app falls back to a local SQLite database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/task_manager

# Secret key used to sign JWT access tokens. Use a long, random string in production.
SECRET_KEY=your-secret-key-here
